<resources>
    <style name="Theme.Soubenco" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_violet</item>
        <item name="colorAccent">@color/brand_orchid</item>
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowBackground">@color/page_bg</item>
    </style>
    <style name="Theme.Soubenco.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Soubenco</item>
    </style>
</resources>
